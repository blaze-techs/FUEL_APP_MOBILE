{
  "name": "fuelpro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "FuelPro - Fuel Station Management System",
  "author": "FuelPro",
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^7.6.5",
    "@capacitor/core": "^8.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^1.14.3",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/react": "^10.57.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "@xenova/transformers": "^2.17.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "core-js": "^3.49.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "eventemitter3": "^5.0.4",
    "file-saver": "^2.0.5",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.43.0",
    "hls.js": "^1.7.1",
    "hono": "^4.12.23",
    "html2canvas": "^1.4.1",
    "jose": "6.1.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.510.0",
    "mysql2": "^3.14.1",
    "nanoid": "^5.1.6",
    "pako": "^2.2.0",
    "pdfjs-dist": "^5.6.205",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-router": "^7.5.3",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.10.1",
    "resize-observer-polyfill": "^1.5.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "swagger-ui-react": "^5.32.11",
    "tailwind-merge": "^3.6.0",
    "vite-plugin-pwa": "^1.3.0",
    "whatwg-fetch": "^3.6.20",
    "workbox-window": "^7.4.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@hono/vite-dev-server": "^0.19.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.0.3",
    "@types/pako": "^2.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.8",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.24.0",
    "globals": "15.15.0",
    "jsdom": "^30.0.1",
    "pg": "^8.22.0",
    "postcss": "^8.5.3",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.16",
    "wrangler": "^4.126.0"
  },
  "scripts": {
    "clean:cache": "rimraf node_modules/.vite dist",
    "build": "node scripts/stamp-version.mjs && npm run clean:cache && vite build && node scripts/postbuild-version.mjs",
    "build:api": "echo 'API runs as Vercel serverless functions from /api — no separate API build needed'",
    "build:vercel": "node scripts/stamp-version.mjs && npm run clean:cache && vite build && node scripts/postbuild-version.mjs",
    "build:static": "node scripts/stamp-version.mjs && npm run clean:cache && vite build && node scripts/postbuild-version.mjs",
    "dev": "vite",
    "start": "vite preview",
    "check": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "electron": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win --x64",
    "electron:build:all": "npm run build && electron-builder --win --mac --linux",
    "cap:init": "npx cap init FuelPro com.fuelpro.app --web-dir dist",
    "cap:add:android": "npx cap add android",
    "cap:build": "npm run build && npx cap sync && cd android && ./gradlew assembleRelease",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "deploy": "vercel --prod"
  },
  "build": {
    "appId": "com.fuelpro.app",
    "productName": "FuelPro",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png",
      "publish": [
        {
          "provider": "github",
          "owner": "fuelpropay",
          "repo": "FUEL_APP_MOBILE"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FuelPro"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon-512.png",
      "category": "Office"
    }
  }
}
